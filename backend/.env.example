# Copy to backend/.env for local development (`pnpm dev` loads it automatically).
# Comments must be on their own line.

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (docker compose up -d db; compose publishes it on host port 5439) ---
DATABASE_URL=postgres://app:app@localhost:5439/competitorpulse
PG_POOL_MAX=10

# --- Scheduler ---
# How often each tracked competitor is polled. Demo value; production would be 900000 (15 min).
POLL_INTERVAL_MS=10000
# How often the poll worker looks for competitors that are due.
SCHEDULER_TICK_MS=1000
# Max competitors claimed per tick, and how many are fetched in parallel.
POLL_BATCH_SIZE=10
POLL_CONCURRENCY=5
SOURCE_TIMEOUT_MS=10000
# Set to false for an API-only instance (no polling, no summaries).
WORKERS_ENABLED=true

# --- AI change summaries ---
SUMMARY_TICK_MS=1000
SUMMARY_CONCURRENCY=3
# Backoff between LLM attempts: base * 2^(attempt-1), capped. Demo values; production: 10000 / 600000 with LLM_MAX_ATTEMPTS=5.
SUMMARY_BACKOFF_BASE_MS=2000
SUMMARY_BACKOFF_MAX_MS=60000
# Default: the provided mock server (python3 mock-llm/mock-llm-server.py, or docker compose up -d mock-llm).
LLM_BASE_URL=http://localhost:4001/v1
LLM_API_KEY=mock
LLM_MODEL=mock-llm
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1, LLM_API_KEY=sk-..., LLM_MODEL=gpt-4o-mini
# Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=llama3.2
LLM_TIMEOUT_MS=15000
LLM_MAX_ATTEMPTS=3

# --- Paths (defaults resolve relative to the backend package) ---
# FIXTURES_PATH=./fixtures/listings.json
# Set to serve the built frontend from the backend (production). Unset in dev; Vite proxies /api instead.
# STATIC_DIR=./public
