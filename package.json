{
  "name": "competitor-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Tracks competitor product listings over time and uses an LLM to explain what changed between snapshots.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter backend test:integration"
  }
}
