{
  "name": "competitor-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tracks competitor product listings over time and uses an LLM to explain what changed between snapshots.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter backend test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
